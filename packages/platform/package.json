{
	"name": "@webforai/platform",
	"version": "0.1.0",
	"description": "Typed, dependency-free client for the webforai platform crawl-to-Markdown API",
	"author": "inaridiy",
	"license": "Apache-2.0",
	"keywords": [
		"web",
		"ai",
		"markdown",
		"scraping",
		"crawler",
		"api-client"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/inaridiy/webforai.git",
		"directory": "packages/platform"
	},
	"homepage": "https://webforai.dev/platform",
	"type": "module",
	"main": "./dist/cjs/index.js",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@tsconfig/recommended": "^1.0.3",
		"@types/node": "^20.14.10",
		"rimraf": "^5.0.5",
		"typescript": "^5.4.5"
	}
}
