{
	"name": "platform",
	"private": true,
	"type": "module",
	"description": "webforai platform — crawl-to-markdown SaaS on Cloudflare",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsx scripts/prerender.ts",
		"deploy": "pnpm build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply platform --local",
		"db:migrate:remote": "wrangler d1 migrations apply platform --remote",
		"stripe:setup": "tsx scripts/stripe-setup.ts",
		"cf-typegen": "wrangler types",
		"test:browser": "tsx tests/browser/dashboard.ts",
		"test:integration": "tsx tests/integration/page-accounting.ts && tsx tests/integration/email-otp.ts && tsx tests/integration/delete-account.ts && tsx tests/integration/billing-repo.ts && tsx tests/integration/api-key-limits.ts && tsx tests/integration/job-capacity.ts"
	},
	"dependencies": {
		"@better-auth/api-key": "1.6.26",
		"@better-auth/stripe": "1.6.26",
		"@cloudflare/containers": "^0.3.7",
		"@cloudflare/playwright": "^1.3.5",
		"aws4fetch": "^1.0.20",
		"better-auth": "1.6.26",
		"capnweb": "^0.10.0",
		"create-nodejs-fn": "^0.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.10.3",
		"playwright": "1.62.1",
		"streamdown": "^2.5.0",
		"stripe": "^22.4.0",
		"undici": "^8.10.0",
		"webforai": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.51.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.1.2",
		"drizzle-kit": "^0.31.10",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.1",
		"typescript": "^5.4.5",
		"vite": "^7.3.6",
		"vitest": "1.3.0",
		"wrangler": "^4.120.0"
	}
}
